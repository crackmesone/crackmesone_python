{
    "Database": {
        "URL": "mongodb://127.0.0.1:27017",
        "Name": "crackmesone"
    },
    "Server": {
        "Host": "127.0.0.1",
        "Port": 8081
    },
    "Session": {
        "SecretKey": "change-this-to-a-secure-random-string",
        "CookieName": "crackmesone"
    },
    "RateLimiter": {
        "Enabled": true,
        "StorageUri": "memory://",
        "Limits": {
            "FlagSubmissions": "5 per minute; 20 per hour"
        }
    },
    "Discord": {
        "Enabled": false,
        "WebhookPublic": "your-public-discord-webhook-url",
        "WebhookPrivate": "your-private-discord-webhook-url",
        "WebhookModeration": "your-moderation-discord-webhook-url"
    },
    "Reviewer": {
        "Enabled": false,
        "PasswordSalt": "change-this-to-a-secure-random-salt"
    },
    "Email": {
        "Enabled": false,
        "ApiKey": "re_your_resend_api_key",
        "From": "crackmes.one <admin@mail.crackmes.one>"
    },
    "Site": {
        "BaseURL": "https://crackmes.one"
    },
    "Writeup": {
        "ObfuscationSalt": "change-this-to-a-secure-random-salt"
    },
    "Altcha": {
        "Enabled": false,
        "HmacSecret": "",
        "HmacKeySecret": "",
        "Cost": 500,
        "MinCounter": 250,
        "MaxCounter": 750,
        "ExpiresMinutes": 20,
        "Protect": {
            "Crackme": true,
            "Writeup": true,
            "Register": false,
            "Comment": false
        },
        "WidgetUrl": "https://cdn.jsdelivr.net/npm/altcha@3.2.1/dist/main/altcha.min.js"
    }
}
